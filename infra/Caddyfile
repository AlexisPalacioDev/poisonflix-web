# poisonflix-web same-origin reverse proxy.
# Serves the web app AND the backend APIs under a single origin via path
# prefixes (solves browser CORS; keeps the Jellyseerr `connect.sid` cookie
# first-party). Upstreams are reached by container name over the two docker
# networks this proxy joins (see docker-compose.yml).
#
# SECURITY: /prowlarr /radarr /sonarr are no longer proxied directly to the
# *arr admin APIs. They (and /bff/*) go to the poisonflix-bff service, which
# authenticates the caller's Jellyseerr session and injects each *arr's
# X-Api-Key server-side. No API key is handled by Caddy anymore.

:8600 {
	# Jellyfin API + media streaming -> strip /jellyfin prefix
	handle_path /jellyfin/* {
		reverse_proxy jellyfin-ts:8096
	}

	# Jellyseerr API -> strip /jellyseerr prefix
	handle_path /jellyseerr/* {
		reverse_proxy jellyseerr:5055
	}

	# *arr traffic + the BFF's own endpoints -> poisonflix-bff. `handle` (not
	# handle_path) keeps the /radarr|/sonarr|/prowlarr prefix in the path: the
	# BFF dispatches on it and strips it itself before calling the upstream.
	# The Cookie header is forwarded by default so the BFF can validate the
	# Jellyseerr session.
	handle /prowlarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /radarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /sonarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /bff/* {
		reverse_proxy poisonflix-bff:8787
	}

	# Native Android APK self-update channel (poisonflix Kotlin app polls
	# /updates/version.json). Static files from ./updates. Intentionally public
	# (no secrets); the native app hits it over the LAN, not this public origin.
	handle_path /updates/* {
		root * /updates
		file_server
	}

	# Everything else: serve the built web app (SPA fallback to index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
