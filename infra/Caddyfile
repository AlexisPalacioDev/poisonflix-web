# poisonflix-web same-origin reverse proxy.
# Serves the web app AND the backend APIs under a single origin via path
# prefixes (solves browser CORS; keeps the Jellyseerr `connect.sid` cookie
# first-party). Upstreams are reached by container name over the two docker
# networks this proxy joins (see docker-compose.yml).
#
# SECURITY: /prowlarr /radarr /sonarr are no longer proxied directly to the
# *arr admin APIs. They (and /bff/*) go to the poisonflix-bff service, which
# authenticates the caller's Jellyseerr session and injects each *arr's
# X-Api-Key server-side. No API key is handled by Caddy anymore.

:8600 {
	# Jellyfin API + media streaming -> strip /jellyfin prefix
	handle_path /jellyfin/* {
		reverse_proxy jellyfin-ts:8096
	}

	# Jellyseerr API -> strip /jellyseerr prefix
	handle_path /jellyseerr/* {
		reverse_proxy jellyseerr:5055
	}

	# *arr traffic + the BFF's own endpoints -> poisonflix-bff. `handle` (not
	# handle_path) keeps the /radarr|/sonarr|/prowlarr prefix in the path: the
	# BFF dispatches on it and strips it itself before calling the upstream.
	# The Cookie header is forwarded by default so the BFF can validate the
	# Jellyseerr session.
	handle /prowlarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /radarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /sonarr/* {
		reverse_proxy poisonflix-bff:8787
	}
	handle /bff/* {
		reverse_proxy poisonflix-bff:8787
	}

	# Native Android APK self-update channel (poisonflix Kotlin app polls
	# /updates/version.json). Static files from ./updates. Intentionally public
	# (no secrets); the native app hits it over the LAN, not this public origin.
	handle_path /updates/* {
		root * /updates
		file_server
	}

	# EmulatorJS runtime for "modo gamer" — cores and wasm blobs fetched by
	# infra/fetch-emulatorjs.sh into infra/www/emulatorjs (289 MB, git-ignored).
	# It sits under the same ./www root the SPA is served from, so this block
	# looks redundant. It is not, for two reasons, both about the fallback
	# below. `try_files {path} /index.html` answers a MISSING file with the SPA
	# shell and a 200, so a core that failed to download would reach the
	# emulator as HTML that parses as garbage instead of an honest 404. And
	# `@dynamic not path /assets/*` would tag every core `no-cache`, making the
	# browser revalidate hundreds of megabytes on each launch. The release is
	# version-pinned and its contents never change, so it caches like /assets.
	handle /emulatorjs/* {
		root * /srv

		# `@present file`, NOT a bare `header`. A bare header applies to the 404
		# too, and this route 404s for a very ordinary reason: deploy.sh treats a
		# failed fetch-emulatorjs.sh as non-fatal, so a deploy can legitimately
		# ship with the runtime missing. `immutable, max-age=31536000` on that
		# 404 tells every browser that visited during the gap to keep believing
		# the core does not exist FOR A YEAR — modo gamer would stay broken for
		# those users long after the runtime was restored, and only a hard
		# reload would clear it. Cache the files; never cache their absence.
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	# Everything else: serve the built web app (SPA fallback to index.html).
	handle {
		root * /srv
		try_files {path} /index.html

		# Content-addressed build assets (hashed filenames) never change -> cache
		# them forever so repeat loads are instant.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# The HTML shell (served for every SPA route) and the service worker MUST
		# always revalidate, or iOS Safari's heuristic HTTP cache serves a stale
		# index.html pointing at an old JS bundle after a deploy -> users run old
		# code. `no-cache` = revalidate every time (ETag makes this cheap).
		@dynamic not path /assets/*
		header @dynamic Cache-Control "no-cache"

		file_server
	}
}
