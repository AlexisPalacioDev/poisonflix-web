# poisonflix-web infra secrets. Copy to `infra/.env` (gitignored) and fill in the
# real values. Consumed by docker-compose.yml (the BFF service).
#
#   cp infra/env.example infra/.env   # then edit
#
# The *arr admin API keys — each service's Settings > General > API Key.
# These live ONLY in the BFF now; they are never sent to the browser.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Upstreams (container names on the media-automation docker network). Override
# only if your service names/ports differ.
JELLYSEERR_URL=http://jellyseerr:5055
RADARR_URL=http://radarr:7878
SONARR_URL=http://sonarr:8989
PROWLARR_URL=http://prowlarr:9696

# Self-service registration + admin user management. The BFF creates Jellyfin
# accounts (admin API key) and imports them into Jellyseerr (its API key).
# JELLYFIN_URL uses jellyfin-ts because Jellyfin shares that container's network
# namespace; the BFF joins jellyfin-server_default to resolve it by name.
JELLYFIN_URL=http://jellyfin-ts:8096
JELLYFIN_API_KEY=
JELLYSEERR_API_KEY=

# Música feature (poisonflix-music-worker). The worker mounts the shared media
# disk and writes /media/Music; DATA_DIR is the HOST base path whose `media`
# subdir holds the library (same disk Jellyfin serves). PUID/PGID must match
# Jellyfin's so downloaded files are readable by it. JELLYFIN_URL/JELLYFIN_API_KEY
# above are reused by the worker (library ensure + scans).
# /data on this host, NOT a placeholder path. Every bind in the compose file
# carries create_host_path, so a DATA_DIR that does not exist is silently CREATED
# empty rather than failing: music downloads then succeed into a directory
# Jellyfin never reads, and nothing reports a problem.
DATA_DIR=/data
PUID=1000
PGID=1000

# Modo gamer (EmulatorJS). There is no worker: the BFF lists and streams ROMs
# straight off the media disk. DATA_DIR above is reused — the library is
# ${DATA_DIR}/games on the host, mounted read-only at /games inside the BFF.
# GAMES_DIR is fixed in docker-compose.yml (like MUSIC_WORKER_URL) rather than
# set here, because compose's `environment:` wins over `env_file:` — a value in
# .env would be read, look right, and do nothing.
#
# Layout: one folder per system, files directly inside it.
#   ${DATA_DIR}/games/snes/Chrono Trigger (USA).sfc
# The folder name IS the system and is passed to EmulatorJS verbatim, so the
# CASING MATTERS (segaMD, not segamd). Valid names:
#   nes snes n64 gb gbc gba nds psx segaMD segaCD segaSaturn segaGG segaMS
#   sega32x atari2600 atari7800 lynx jaguar vb pce ngp ws 3do arcade coleco c64
# Any other folder is ignored in silence, so bios/, saves/ and covers/ can live
# beside them without becoming games.
#
# The browser-side runtime (289 MB of cores) is NOT in git: run
# infra/fetch-emulatorjs.sh once. infra/deploy.sh calls it on every deploy,
# which is required — the deploy replaces the whole infra/www directory.

# "Ver en la tele" (LAN casting). Discovery is SSDP/mDNS multicast, which a
# container on a docker bridge network cannot do — measured: 0 devices from a
# bridge, the TV from host networking. So it lives in the `cast-bridge` service,
# which runs with `network_mode: host`.
#
# That choice has one consequence you have to configure: `network_mode: host` is
# mutually exclusive with `networks:`, so cast-bridge has NO service name on any
# docker network and cannot be dialled as `http://cast-bridge:8791`. The BFF
# reaches it at the docker GATEWAY address instead — the host's own address on
# the media-automation bridge — and cast-bridge binds to that same address.
#
# THAT ADDRESS IS PER-HOST. The value below is the one measured on the deploy
# target so a normal deploy needs no extra step — it is NOT a value to copy onto
# another machine. On any other host, read the real one off it:
#
#   docker network inspect media-automation --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
#
# Measured values, as an illustration of why this is not a constant:
#   mendezserver (deploy target) -> 172.19.0.1
#   dev laptop                   -> 172.21.0.1
# (172.18.0.1 is jellyfin-server_default's gateway on mendezserver, not this
# network's — close enough to look right, which is the whole problem.)
#
# One variable feeds BOTH the bridge's bind address and the URL the BFF dials;
# docker-compose.yml derives CAST_BRIDGE_BIND and CAST_BRIDGE_URL from it. Set
# CAST_GATEWAY_IP, NOT CAST_BRIDGE_URL: compose's `environment:` wins over
# `env_file:`, so a CAST_BRIDGE_URL here would be read, look right, and do
# nothing (same trap as GAMES_DIR above).
#
# Getting it wrong does not crash anything, which is exactly why it is spelled
# out at this length: the BFF answers `{ devices: [] }` with a 200 whenever the
# bridge is unreachable, so a wrong gateway is indistinguishable from a LAN with
# no televisions on it. The one place that can tell you is the log —
# `docker compose logs bff | grep '"scope":"cast.devices"'` prints the address
# it could not reach.
#
# A wrong value is at least not silent on the bridge's side: it cannot bind an
# address the host does not have, so the container restart-loops and shows up in
# `docker ps`. "Not configured" and "configured for the other machine" are the
# two states to tell apart, and those are their two symptoms.
#
# The bridge listens on port 8791 (music-worker uses 8790). Because it is on
# host networking, that port must be free on the HOST, not just in a namespace —
# check with `ss -lntp | grep 8791` before deploying. This is not theoretical:
# it was measured free on mendezserver and already TAKEN on a dev laptop by an
# unrelated local process. Whoever binds it first becomes what the BFF talks to,
# and nothing authenticates it, which is why bff/cast.mjs refuses to follow
# redirects from this port.
CAST_GATEWAY_IP=172.19.0.1

# Tailscale Funnel auth key (public exposure). See infra/tailscale/README.md.
# Leave empty to log in interactively instead.
TS_AUTHKEY=
